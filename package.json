{
  "name": "relic",
  "version": "0.2.0",
  "versionNames": {
    "stable": "Primera Piedra",
    "beta": "Fragmento"
  },
  "private": true,
  "main": "build/main/main.js",
  "homepage": "./",
  "license": "GPL-3.0-only",
  "description": "Relic - Linux games installer for GOG, Epic Games and Amazon Games",
  "repository": {
    "type": "Github",
    "url": "https://github.com/FranjeGueje/Relic"
  },
  "author": {
    "name": "Relic",
    "email": ""
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "electron-vite dev --watch",
    "codecheck": "tsc --noEmit",
    "test": "jest",
    "test-watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand --silent",
    "test:e2e": "electron-vite build && cross-env CI=e2e xvfb-maybe -- playwright test",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --fix --ext .tsx,ts ./src",
    "i18n": "i18next --silent",
    "prepare": "husky",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "download-helper-binaries": "esbuild --bundle --platform=node --target=node24 meta/downloadHelperBinaries.ts | node",
    "lint-translations": "esbuild --bundle --platform=node --target=node24 meta/lintTranslations.ts | node"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
