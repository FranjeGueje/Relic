    "undici": "^7.28.0",
    "vite": "^6.4.3",
    "vite-plugin-svgr": "^4.5.0",
    "xvfb-maybe": "^0.2.1"
  },
  "resolutions": {
    "ts-morph": "17.0.1"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4",
      "cross-spawn": ">=6.0.6",
      "tar": ">=7.5.19",
      "uuid": "^11.0.0"
    }
  }
