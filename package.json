{
  "name": "relic",
  "version": "0.6.0",
  "versionNames": {
    "stable": "Trazo firme",
    "beta": "Fragmento"
  },
  "private": true,
  "main": "build/main/main.js",
  "homepage": "./",
  "license": "GPL-3.0-only",
  "description": "Relic - Linux games installer for GOG, Epic Games and Amazon Games",
  "desktopName": "Relic",
  "repository": {
    "type": "Github",
    "url": "https://github.com/FranjeGueje/Relic"
  },
  "author": {
    "name": "Relic",
    "email": "fjgj1@hotmail.com"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "start": "node node_modules/electron/install.js && electron-vite dev --watch",
    "codecheck": "tsc --noEmit",
    "test": "jest",
    "test-watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand --silent",
    "test:e2e": "electron-vite build && CI=e2e xvfb-maybe -- playwright test",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --fix --ext .tsx,ts ./src",
    "i18n": "i18next-cli extract --quiet",
    "prepare": "husky",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "download-helper-binaries": "esbuild --bundle --platform=node --target=node24 meta/downloadHelperBinaries.ts | node",
    "lint-translations": "esbuild --bundle --platform=node --target=node24 meta/lintTranslations.ts | node"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/cabin": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@node-steam/vdf": "^2.2.0",
    "axios": "^1.18.1",
    "easydl": "^1.2.0",
    "fuse.js": "^7.5.0",
    "i18next": "^22.5.1",
    "i18next-fs-backend": "^2.6.6",
    "i18next-http-backend": "^3.0.6",
    "json5": "^2.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^12.3.1",
    "react-router-dom": "^6.30.4",
    "shlex": "^3.0.0",
    "simple-keyboard": "^3.8.170",
    "steam-shortcut-editor": "^3.1.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/tmp": "^0.2.6",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "i18next-cli": "^1.67.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "tmp": "^0.2.7",
    "ts-jest": "^29.4.12",
    "type-fest": "^3.13.1",
    "typed-emitter": "^2.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vite-plugin-svgr": "^4.5.0",
    "xvfb-maybe": "^0.2.1",
    "zod": "4"
  }
}
